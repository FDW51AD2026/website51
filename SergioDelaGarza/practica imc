<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Calculo del IMC</title>
</head>
<body>
    <p>Crear una aplicación para que calcule el IMC.</p>
    <div style="border: 1px solid #ccc; padding: 10px; width: 300px;">
        Peso: <input type="text" id="peso"> <br><br>
        Altura: <input type="text" id="altura"> <br><br>
        IMC: <input type="text" id="imc"> <br><br>
        Resultado: <input type="text" id="resultado"> <br><br>
        <button onclick="calcular()">Calcular</button>
    </div>
    <script>
        function calcular() {
            var peso = parseFloat(document.getElementById("peso").value);
            var altura = parseFloat(document.getElementById("altura").value);
            var imc = peso / (altura * altura);
            document.getElementById("imc").value = imc.toFixed(2);
            var resultado = "";
            if (imc < 18.5) {
                resultado = "Bajo Peso";
            } else if (imc >= 18.5 && imc <= 25) {
                resultado = "Peso Normal";
            } else {
                resultado = "Sin clasificación";
            }

            document.getElementById("resultado").value = resultado;
        }
    </script>
</body>
</html>
